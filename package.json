{
  "name": "@ts-utilities/notify",
  "version": "0.0.4",
  "author": "Sohan Emon <sohanemon@outlook.com>",
  "description": "Sonner like notifier for cli",
  "type": "module",
  "files": [
    "dist"
  ],
  "source": "./src/index.ts",
  "types": "./dist/index.d.cts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "types": [
        "dist/types.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "test:run": "vitest run --silent",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write --unsafe .",
    "format": "biome format .",
    "format:write": "biome format . --write",
    "typecheck": "tsgo --noEmit",
    "release": "tsgo --noEmit && npm run build && npm publish"
  },
  "keywords": [
    "utils",
    "cli",
    "typescript"
  ],
  "license": "ISC",
  "homepage": "https://sohanjs.web.app/notify",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ts-collection/notify.git"
  },
  "bugs": {
    "url": "https://github.com/ts-collection/notify/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.10.1",
    "tsdown": "^0.16.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "log-update": "^8.0.0"
  }
}
